# Internal static server for the Neutorium site (container: neutorium-site).
# TLS is terminated by the shared meditrono Caddy in front of it.
{
	auto_https off
	admin off
}

:80 {
	root * /srv/current
	encode zstd gzip

	# Neutorium CMS (Strapi, container neutorium-cms) on the same domain:
	# the panel at /addme, its admin API and plugin routes, the public content API and uploads.
	@cms path /addme /addme/* /admin/* /api/* /uploads/* /content-manager/* /content-type-builder/* /upload/* /users-permissions/* /i18n/* /email/* /content-releases/* /review-workflows/* /ai-assistant/*
	handle @cms {
		# Never index the CMS (and do not list /addme in robots.txt, which would advertise it).
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy neutorium-cms:1337
	}

	# Hashed build output: cache forever, 404 when missing.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Pre-rendered pages (dist/<route>/index.html) first, then the SPA shell for anything else.
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
