# Internal static server for the Neutorium site (container: neutorium-site).
# TLS is terminated by the shared meditrono Caddy in front of it.
{
	auto_https off
	admin off
}

:80 {
	root * /srv/current
	encode zstd gzip

	# Hashed build output: cache forever, 404 when missing.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: SPA fallback to index.html for client-side routes.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
