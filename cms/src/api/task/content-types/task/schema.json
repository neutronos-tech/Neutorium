{
  "kind": "collectionType",
  "collectionName": "tasks",
  "info": {
    "singularName": "task",
    "pluralName": "tasks",
    "displayName": "Task",
    "description": "Team task board. Assign each task to one person; filter by Assignee to see your own."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "backlog",
        "todo",
        "in_progress",
        "review",
        "done"
      ],
      "default": "todo",
      "required": true
    },
    "priority": {
      "type": "enumeration",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "required": true
    },
    "area": {
      "type": "enumeration",
      "enum": [
        "aeo",
        "seo",
        "content",
        "technical",
        "authority",
        "analytics",
        "design",
        "sales",
        "ops"
      ],
      "required": true
    },
    "assignee": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "admin::user"
    },
    "dueDate": {
      "type": "date"
    },
    "phase": {
      "type": "integer"
    },
    "step": {
      "type": "integer"
    },
    "description": {
      "type": "richtext"
    },
    "checklist": {
      "type": "component",
      "repeatable": true,
      "component": "task.checklist-item"
    },
    "comments": {
      "type": "component",
      "repeatable": true,
      "component": "task.comment"
    },
    "links": {
      "type": "text"
    }
  }
}
