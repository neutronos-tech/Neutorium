{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site settings",
    "description": "Business facts used across the website, llms.txt and structured data. Keep them identical to every external profile."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "serviceArea": {
      "type": "string"
    },
    "description": {
      "type": "text",
      "maxLength": 300
    },
    "socials": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
