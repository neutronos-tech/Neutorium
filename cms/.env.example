# Copy to .env and fill in. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Browsers allowed to call the API (comma separated).
CORS_ORIGINS=https://neutorium.com,https://www.neutorium.com,http://localhost:5173

# Database: sqlite (default, local) or postgres (production).
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://neutorium:password@db:5432/neutorium_cms

# Optional: rebuild the website when content changes (GitHub fine-grained token with
# "Actions: read and write" on neutronos-tech/test).
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=neutronos-tech/test
